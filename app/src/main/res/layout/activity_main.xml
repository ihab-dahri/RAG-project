<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117"
    android:padding="16dp">

    <!-- En-tête / Boutons d'actions haut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnSelectPdf"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="📁 Importer PDF"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F6FEB"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSummary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="⚡ Résumer"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#238636"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="🗑️"
            android:backgroundTint="#DA3633"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Zone de discussion & Chargement -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#2F66FF"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Barre de saisie style "Flottante" en bas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_input_box"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/etQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Posez votre question..."
            android:textColorHint="#6E7681"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:padding="8dp"
            android:inputType="text" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Parler"
            android:layout_marginEnd="4dp"
            app:tint="#8B949E" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Envoyer"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2F66FF"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

</LinearLayout>